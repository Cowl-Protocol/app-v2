# Sign in. Copy to `.env.local` and fill in, or leave the file out entirely.
#
# Without these the app still runs and every screen behind the door is still
# reachable with `SKIP_LOGIN` in `src/config/ui.ts`. What you lose is the Google
# button, which reports that this build has no credentials rather than failing at
# Google's door with a page nobody can read.
#
# Everything here is public. These identifiers are readable by anyone who opens
# the page and neither authorises anything on its own: the auth proxy checks the
# request origin against an allowlist in Turnkey's dashboard, and Google checks
# the redirect uri against one in Google's. There is deliberately no secret in
# this app, because `output: "export"` means there is no server to keep one in.
#
# `NEXT_PUBLIC_` is what makes a value reach the browser under Next, and a static
# export bakes it in at build time, so changing any of these means a rebuild.

# Turnkey · Dashboard · Embedded Wallets · Configuration · Auth Proxy Config ID.
# In that same panel: allowlist this app's origin, enable Google, and turn OFF
# every method you are not using. Email OTP left on is a second door into the
# same shielded account, and a weaker one than the Google account it sits beside.
NEXT_PUBLIC_TURNKEY_AUTH_PROXY_CONFIG_ID=

# Google Cloud · APIs and Services · Credentials · OAuth 2.0 Client ID, type Web
# application. It needs both:
#   Authorised JavaScript origins:  http://localhost:3000
#   Authorised redirect URIs:       http://localhost:3000/auth/callback
# Google compares these as strings, so the scheme, the port and the trailing
# slash all have to match exactly what the browser sends.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional. Where Google returns the sign in popup to. Left blank it is this
# origin's `/auth/callback`, which is right for a laptop and for any deployment
# served from the host being visited. Set it when a build is served from a host
# it cannot read off `window.location`.
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=
